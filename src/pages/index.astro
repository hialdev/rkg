---
import Layout from "../layouts/Layout.astro";
import type { PageMetaType } from "../types/page";
import LocaleHomeContent from "../components/sections/home/LocaleHomeContent";
import EventStatistics from "../components/sections/home/EventStatistics";
import TeamBox from "../components/sections/home/TeamBox";
import ClientList from "../components/sections/home/ClientList";
import ConsultationBox from "../components/sections/home/ConsultationBox";

const metaData: PageMetaType = {
   title: "RKG Tour & Travel | Your Professional Travel Partner",
   description: "RKG Tour & Travel is your trusted partner for professional travel services, offering comprehensive tour packages, travel arrangements, and unforgettable journey experiences across destinations.",
   image: "/assets/rkgtour.webp",
   robot: true,
};
---

<Layout isFloating={true} pageMeta={metaData}>
   <LocaleHomeContent client:only="react" />
   
   {/* Event Statistics Section */}
   <div id="event-statistics-wrapper">
      <EventStatistics client:only="react" />
   </div>
   
   {/* Team Box Section */}
   <section class="py-10 bg-stone-950 px-3">
      <div class="container mx-auto">
         <h2 class="text-5xl font-medium text-yellow-500 mb-10">Our Team</h2>
         <div id="team-box-wrapper">
            <TeamBox client:only="react" />
         </div>
      </div>
   </section>
   
   {/* Client List Section */}
   <section class="py-20 px-3">
      <div id="client-list-wrapper">
         <ClientList client:only="react" />
      </div>
   </section>
   
   {/* Consultation Box Section */}
   <section class="py-20 px-3">
      <div id="consultation-box-wrapper">
         <ConsultationBox client:only="react" />
      </div>
   </section>
</Layout>
