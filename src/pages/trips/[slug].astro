---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import type { PageMetaType } from "../../types/page";
import { Icon } from "@iconify-icon/react";
import LocaleDetailTrip from "../../components/sections/trips/LocaleDetailTrip";
import { getTripBySlug, type Trip } from "../../fetchers";

export const getStaticPaths: GetStaticPaths = async () => {
   return []
};

export const prerender = false;

const { slug } = Astro.params;
const resTrip = await getTripBySlug(String(slug) ?? '')
const tripData:Trip = resTrip.data.data[0]

const metaData: PageMetaType = {
   title: `${tripData?.title} | RKG Tour & Travel`,
   description: tripData?.description || "",
   image: tripData?.image ? import.meta.env.PUBLIC_API_URL+'/'+tripData?.image : "/assets/rkgtour.webp",
   robot: true,
};

---

<Layout pageMeta={metaData}>
   <div class="container mx-auto px-4">
      <div
         onclick="window.history.back()"
         class="items-center gap-5 cursor-pointer inline-flex hover:bg-stone-100 mt-10 px-6 py-3 rounded-full border"
      >
         <Icon client:load icon="mdi:arrow-left" />
      </div>
   </div>

   <LocaleDetailTrip client:only tripData={tripData} />
</Layout>
