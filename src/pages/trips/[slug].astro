---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import GalleryProgressBar from "../../components/sections/gallery/GalleryProgressBar";
import ItineraryPath from "../../components/sections/ItineraryPath";
import TestiImageSlider from "../../components/sections/gallery/TestiImageSlider";
import DestinationSlider from "../../components/sections/gallery/DestinationSlider";
import PrivateTripBook from "../../components/forms/PrivateTripBook";
import OpenTripBook from "../../components/forms/OpenTripBook";
import type { PageMetaType } from "../../types/page";
import { tripsData } from "../../mock";
import { Icon } from "@iconify-icon/react";
import FAQBlock from "../../components/sections/search/FAQBlock";
import { currentLocale, currentTranslations } from "../../stores/locale";

export const getStaticPaths: GetStaticPaths = () => {
   return tripsData.map((trip) => ({
      params: { slug: trip.slug },
   }));
};

const { slug } = Astro.params;
const tripData = tripsData.find((trip) => trip.slug === slug);

const metaData: PageMetaType = {
   title: `${tripData?.title} | RKG Tour & Travel`,
   description: tripData?.content || "",
   image: tripData?.image?.path || "/assets/rkgtour.webp",
   robot: true,
};
---

<Layout pageMeta={metaData}>
   <div class="container mx-auto px-4">
      <div onclick="window.history.back()" class="items-center gap-5 cursor-pointer inline-flex hover:bg-stone-100 mt-10 px-6 py-3 rounded-full border"
         ><Icon client:load icon="mdi:arrow-left" />
         </div
      >
   </div>

   {
      tripData ? (
         tripData.type == "private-trip" ? (
            <div class="container mx-auto px-4 py-8">
               <div>
                  <GalleryProgressBar
                     images={tripData.images.map((image) => image.path)}
                     altTexts={tripData.images.map((image) => image.alt)}
                     client:load
                  />
               </div>
               <div class="grid grid-cols-13 mt-6 gap-y-10 md:gap-5">
                  <div class="col-span-13 md:col-span-7">
                     <div
                        class={`${"p-2 px-4 text-white font-medium text-sm inline-flex rounded-full mb-3"} ${tripData.type == "open-trip" ? "bg-linear-to-bl from-emerald-300 to-cyan-700" : "bg-linear-to-tl from-yellow-400 via-yellow-600 to-orange-300"}`}
                     >
                        {tripData.type == "open-trip"
                           ? "Open Trip"
                           : "Private Trip"}
                     </div>
                     <h1 class="text-3xl md:text-5xl font-bold text-red-600">
                        {tripData.title}
                     </h1>
                     <h2 class="text-xl md:text-2xl my-3">
                        Mulai dari <strong>Rp4.490.000</strong>/person
                     </h2>
                     <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-5">
                        <div class="flex items-center gap-3 p-3 px-6 rounded-full bg-stone-100">
                           <Icon
                              client:load
                              icon={`streamline-kameleon-color:map-pin`}
                              width={25}
                           />
                           <div>
                              <h4 class="font-medium">Meeting Point</h4>
                              <div class="line-clamp-1 whitespace-nowrap">
                                 {tripData.meet_point}
                              </div>
                           </div>
                        </div>
                        <div class="flex items-center gap-3 p-3 px-6 rounded-full bg-stone-100">
                           <Icon
                              client:load
                              icon={`streamline-stickies-color:date-time-setting`}
                              width={25}
                           />
                           <div>
                              <h4 class="font-medium">Season Terbaik</h4>
                              <div class="">{tripData.best_season}</div>
                           </div>
                        </div>
                        <div class="flex items-center gap-3 p-3 px-6 rounded-full bg-stone-100">
                           <Icon
                              client:load
                              icon={`streamline-ultimate-color:trip-pin-multiple`}
                              width={25}
                           />
                           <div>
                              <h4 class="font-medium">Destinasi</h4>
                              <div class="">
                                 {tripData.destinations.length} Destinasi
                              </div>
                           </div>
                        </div>
                        <div class="flex items-center gap-3 p-3 px-6 rounded-full bg-stone-100">
                           <Icon
                              client:load
                              icon={`fluent-emoji-flat:timer-clock`}
                              width={25}
                           />
                           <div>
                              <h4 class="font-medium">Duration</h4>
                              <div class="">{tripData.duration}</div>
                           </div>
                        </div>
                     </div>
                  </div>

                  <div class="col-span-13 md:col-span-6">
                     <PrivateTripBook client:load />
                  </div>
               </div>

               <section class="w-full max-w-4xl py-20">
                  <h2 class="text-4xl font-bold text-red-600">Deskripsi</h2>
                  <div
                     class="prose prose-stone mt-2"
                     set:html={tripData.content}
                  />
               </section>

               <section class="pb-20">
                  <h2 class="text-4xl font-bold text-red-600 mb-10">
                     Testimonials
                  </h2>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                     {tripData.testimonials.map((testi) => {
                        return (
                           <div class="flex items-center gap-5">
                              <TestiImageSlider
                                 client:load
                                 images={testi.images}
                              />
                              <div class="">
                                 <h6 class="text-lg font-medium">
                                    {testi.name}
                                 </h6>
                                 <div class="text-stone-400 italic">
                                    {testi.role}
                                 </div>
                                 <div class="flex items-center gap-1 mb-4 mt-2">
                                    {[...Array(5)].map((_, index) => (
                                       <Icon
                                          client:load
                                          icon={
                                             index < testi.star
                                                ? "mdi:star"
                                                : "mdi:star-outline"
                                          }
                                          width={20}
                                          className={
                                             index < testi.star
                                                ? "text-yellow-400"
                                                : "text-stone-300"
                                          }
                                       />
                                    ))}
                                 </div>
                                 <q>{testi.review}</q>
                              </div>
                           </div>
                        );
                     })}
                  </div>
               </section>

               <section class="py-10">
                  <iframe
                     src={tripData.gmap_link}
                     frameborder="0"
                     style="width: 100%; height: 25em;"
                     allowfullscreen
                     loading="lazy"
                  />
               </section>

               <section class="py-10">
                  <h2 class="text-4xl font-bold text-red-600 mb-10">
                     Destination
                  </h2>
                  <DestinationSlider
                     client:load
                     destinations={tripData.destinations}
                  />
               </section>

               <section class="py-10">
                  <h2 class="text-4xl mb-10 text-stone-900 font-bold underline decoration-yellow-400 decoration-12 underline-offset-3">
                     FAQ
                  </h2>
                  <FAQBlock client:load />
               </section>
            </div>
         ) : (
            <div class="container mx-auto px-4 py-8">
               <div class="grid grid-cols-6 gap-5">
                  <div class="col-span-3">
                     <div class="md:sticky md:top-10">
                        <GalleryProgressBar
                           images={tripData.images.map((image) => image.path)}
                           altTexts={tripData.images.map((image) => image.alt)}
                           client:load
                        />
                     </div>
                  </div>
                  <div class="col-span-3">
                     <div class="grid grid-cols-13 mt-6 gap-y-10 md:gap-5">
                        <div class="col-span-13">
                           <div
                              class={`${"p-2 px-4 text-white font-medium text-sm inline-flex rounded-full mb-3"} ${tripData.type == "open-trip" ? "bg-linear-to-bl from-emerald-300 to-cyan-700" : "bg-linear-to-tl from-yellow-400 via-yellow-600 to-orange-300"}`}
                           >
                              {tripData.type == "open-trip"
                                 ? "Open Trip"
                                 : "Private Trip"}
                           </div>
                           <h1 class="text-2xl md:text-5xl font-bold text-red-600">
                              {tripData.title}
                           </h1>
                           <h2 class="text-xl md:text-2xl my-3">
                              Mulai dari <strong>Rp4.490.000</strong>/person
                           </h2>
                           <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-5">
                              <div class="flex items-center gap-3 p-3 px-6 rounded-full bg-stone-100">
                                 <Icon
                                    client:load
                                    icon={`streamline-kameleon-color:map-pin`}
                                    width={25}
                                 />
                                 <div>
                                    <h4 class="font-medium">Meeting Point</h4>
                                    <div class="line-clamp-1 whitespace-nowrap">
                                       {tripData.meet_point}
                                    </div>
                                 </div>
                              </div>
                              <div class="flex items-center gap-3 p-3 px-6 rounded-full bg-stone-100">
                                 <Icon
                                    client:load
                                    icon={`streamline-stickies-color:date-time-setting`}
                                    width={25}
                                 />
                                 <div>
                                    <h4 class="font-medium">Season Terbaik</h4>
                                    <div class="">{tripData.best_season}</div>
                                 </div>
                              </div>
                              <div class="flex items-center gap-3 p-3 px-6 rounded-full bg-stone-100">
                                 <Icon
                                    client:load
                                    icon={`streamline-ultimate-color:trip-pin-multiple`}
                                    width={25}
                                 />
                                 <div>
                                    <h4 class="font-medium">Destinasi</h4>
                                    <div class="">
                                       {tripData.destinations.length} Destinasi
                                    </div>
                                 </div>
                              </div>
                              <div class="flex items-center gap-3 p-3 px-6 rounded-full bg-stone-100">
                                 <Icon
                                    client:load
                                    icon={`fluent-emoji-flat:timer-clock`}
                                    width={25}
                                 />
                                 <div>
                                    <h4 class="font-medium">Duration</h4>
                                    <div class="">{tripData.duration}</div>
                                 </div>
                              </div>
                           </div>
                        </div>

                        <div class="col-span-13">
                           <OpenTripBook client:load tripData={tripData} />
                        </div>
                     </div>
                  </div>
               </div>

               <section class="w-full max-w-4xl py-20">
                  <h2 class="text-4xl font-bold text-red-600">Deskripsi</h2>
                  <div
                     class="prose prose-stone mt-2"
                     set:html={tripData.content}
                  />
               </section>

               <section class="w-full max-w-4xl py-20">
                  <h2 class="text-4xl font-bold text-red-600 mb-10">
                     Itinerary
                  </h2>
                  <div class="">
                     <ItineraryPath
                        client:load
                        itinerary={tripData.itinerary}
                     />
                  </div>
               </section>

               <section class="pb-20">
                  <h2 class="text-4xl font-bold text-red-600 mb-10">
                     Testimonials
                  </h2>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                     {tripData.testimonials.map((testi) => {
                        return (
                           <div class="flex items-center gap-5">
                              <TestiImageSlider
                                 client:load
                                 images={testi.images}
                              />
                              <div class="">
                                 <h6 class="text-lg font-medium">
                                    {testi.name}
                                 </h6>
                                 <div class="text-stone-400 italic">
                                    {testi.role}
                                 </div>
                                 <div class="flex items-center gap-1 mb-4 mt-2">
                                    {[...Array(5)].map((_, index) => (
                                       <Icon
                                          client:load
                                          icon={
                                             index < testi.star
                                                ? "mdi:star"
                                                : "mdi:star-outline"
                                          }
                                          width={20}
                                          className={
                                             index < testi.star
                                                ? "text-yellow-400"
                                                : "text-stone-300"
                                          }
                                       />
                                    ))}
                                 </div>
                                 <q>{testi.review}</q>
                              </div>
                           </div>
                        );
                     })}
                  </div>
               </section>

               <section class="py-10">
                  <iframe
                     src={tripData.gmap_link}
                     frameborder="0"
                     style="width: 100%; height: 25em;"
                     allowfullscreen
                     loading="lazy"
                  />
               </section>

               <section class="py-10">
                  <h2 class="text-4xl font-bold text-red-600 mb-10">
                     Destination
                  </h2>
                  <DestinationSlider
                     client:load
                     destinations={tripData.destinations}
                  />
               </section>

               <section class="py-10">
                  <h2 class="text-4xl mb-10 text-stone-900 font-bold underline decoration-yellow-400 decoration-12 underline-offset-3">
                     FAQ
                  </h2>
                  <FAQBlock client:load />
               </section>
            </div>
         )
      ) : (
         <div class="container mx-auto px-4 py-8">
            <h1 class="text-3xl font-bold">Trip not found</h1>
         </div>
      )
   }
</Layout>
