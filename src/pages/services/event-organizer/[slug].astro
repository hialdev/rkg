---
import type { GetStaticPaths } from "astro";
import Layout from "../../../layouts/Layout.astro";
import type { PageMetaType } from "../../../types/page";
import LocaleDetailEvent from "../../../components/sections/event/LocaleDetailEvent";
import { getEventTypeBySlug } from "../../../fetchers";

export const getStaticPaths: GetStaticPaths = async () => {
   return []
};

export const prerender = false;

const { slug } = Astro.params;
const resEvent = await getEventTypeBySlug(String(slug) ?? '')
const eventData = resEvent.data.data[0];

const metaData: PageMetaType = {
   title: `${eventData?.title} | RKG Tour & Travel`,
   description: eventData?.description || "",
   image: eventData?.image ? import.meta.env.PUBLIC_API_URL+'/'+eventData?.image : "/assets/rkgtour.webp",
   robot: true,
};
---

<Layout pageMeta={metaData}> 
   <LocaleDetailEvent client:only eventData={eventData} />
</Layout>
