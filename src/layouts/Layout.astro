---
import Footer from "../components/partials/Footer.astro";
import Header from "../components/partials/Header.astro";
import "../styles/global.css";
import { type PageMetaType } from "../types/page"

const { pageMeta } = Astro.props as { pageMeta: PageMetaType };
---

<!doctype html>
<html lang="en">
   <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width" />
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      <meta name="generator" content={Astro.generator} />

      <title>{pageMeta.title}</title>
      <meta name="description" content={pageMeta.description} />
      <meta property="og:image" content={pageMeta.image} />
      <meta
         name="robots"
         content={pageMeta.robot ? "index,follow" : "noindex,nofollow"}
      />
   </head>
   <body>
      <Header />
      <main>
         <slot />
      </main>
      <Footer />
   </body>
</html>
