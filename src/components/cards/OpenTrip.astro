---
import { Image } from "astro:assets";
import OfflineIcon from "../OfflineIcon";
import type { openTrips } from "../../mock";

const { trip } = Astro.props as { trip: (typeof openTrips)[0] };
---

<div class="relative rounded-xl overflow-hidden">
   <div class="absolute rounded-br-xl top-0 start-0 p-2 px-4 bg-emerald-600 text-white font-medium text-sm">
      Best Seller!
   </div>
   <Image src={trip.image.path} alt={trip.image.alt} width={426} height={240} class="aspect-video rounded-xl" />

   <div class="py-4">
      <h2 class="font-medium text-lg">{trip.title}</h2>

      <div class="flex items-center justify-between pt-2 pb-5 border-b">
         <div>
            <div class="text-sm text-stone-400">Destination</div>
            <div class="flex mt-1 items-center gap-2">
               <OfflineIcon client:load name="map" />
               <div class="text-stone-800">{trip.destination}</div>
            </div>
         </div>
         <div>
            <div class="text-sm text-stone-400">Duration</div>
            <div class="flex mt-1 items-center gap-2">
               <OfflineIcon client:load name="clock" />
               <div class="text-stone-800">{trip.duration}</div>
            </div>
         </div>
      </div>

      <div class="flex items-center justify-between pt-3">
         <div>
            <div class="fs-6">Start From</div>
            <div class="text-xl font-medium">Rp{trip.price.toLocaleString("id-ID")}</div>
         </div>
         <button class="bg-red-700 hover:shadow-lg hover:bg-orange-600 text-white cursor-pointer p-2 px-4 rounded-full">Book Now</button>
      </div>
   </div>
</div>
