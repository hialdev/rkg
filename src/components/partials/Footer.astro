---
import { Image } from "astro:assets";
---

<footer class="bg-slate-600 text-white py-20 px-3">
   <div class="container mx-auto">
      <div class="flex flex-col md:flex-row justify-between gap-10">
         <div class="max-w-[40%]">
            <Image
               src={`https://placehold.co/700x250`}
               alt={`Footer logo`}
               width={700}
               height={250}
               class="mb-3"
            />
            <div>
               RKG Tour and Travel is a professional travel agency and event
               organizer, dedicated to creating unforgettable journeys and
               seamless experiences.
            </div>
            <div class="font-medium text-lg mt-5 mb-3">Payment Methods</div>
            <div class="grid grid-cols-10">
               <div class="flex items-center justify-center max-h-[2em] p-1 rounded-md bg-white">
                  <Image src={`https://placehold.co/200x300`} alt={`image payment methods`} width={200} height={300} class="object-contain h-full w-full max-h-[2em]" />
               </div>
            </div>
         </div>
         <div class="">
            <div class="mb-10">
               <h4 class="text-xl font-medium mb-5 text-white">Our Services</h4>
               <nav class="flex flex-col gap-2">
                  <a href="#" class="text-white">Travel</a>
                  <a href="#" class="text-white">Event</a>
                  <a href="#" class="text-white">Production</a>
               </nav>
            </div>

            <div class="">
               <h4 class="text-xl font-medium mb-5 text-white">
                  About RKG Tour & Travel
               </h4>
               <nav class="flex flex-col gap-2">
                  <a href="#" class="text-white">About Us</a>
                  <a href="#" class="text-white">Contact Us</a>
                  <a href="#" class="text-white">Terms & Conditions</a>
                  <a href="#" class="text-white">FAQ</a>
               </nav>
            </div>
         </div>
         <div class="">
            <div class="mb-10">
               <h4 class="text-xl font-medium mb-5 text-white">
                  About RKG Tour & Travel
               </h4>
               <nav class="flex flex-col gap-2">
                  <a href="#" class="text-white">Email : sales@rkgtour.com</a>
                  <a href="#" class="text-white">Admin : +62 8118 8081 120</a>
               </nav>
            </div>
            <div class="">
               <h4 class="text-xl font-medium mb-5 text-white">Our Location</h4>
               <div>
                  <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d126934.52524919015!2d106.68412931640627!3d-6.170385999999998!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69f51beef3a83d%3A0xf33dc651dadbb47d!2sMerdeka%20Palace!5e0!3m2!1sen!2sid!4v1761405139540!5m2!1sen!2sid" class="max-w-[20em]" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
               </div>
            </div>
         </div>
      </div>
   </div>
</footer>
