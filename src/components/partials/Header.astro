---
import { Image } from "astro:assets";
import { menus } from "../../config/menu";
---

<header
   id="navbar"
   class="fixed top-0 left-0 w-full z-50 transition-all duration-300 bg-transparent"
>
   <nav class="container mx-auto flex items-center justify-between py-3 px-4">
      <!-- LOGO -->
      <div class="flex items-center gap-2">
         <Image
            src="https://placehold.co/60x60"
            alt="logo RKG"
            width={60}
            height={60}
            class="rounded-full"
         />
      </div>

      <!-- HAMBURGER ICON -->
      <button
         id="menu-toggle"
         data-open="false"
         class="flex flex-col gap-[6px] md:hidden fixed top-6 right-4 z-[70] w-8 h-8 justify-center items-end transition-all"
      >
         <span
            class="line-1 block w-6 h-[3px] bg-white rounded-full transition-all"
         ></span>
         <span
            class="line-2 block w-4 h-[3px] bg-white rounded-full self-end transition-all"
         ></span>
         <span
            class="line-3 block w-8 h-[3px] bg-white rounded-full transition-all"
         ></span>
      </button>

      <!-- NAV MENU (DESKTOP) -->
      <ul
         id="menu"
         class="hidden md:flex items-center gap-6 text-white font-medium"
      >
         {
            menus.map((menu) => (
               <li class="relative group">
                  <a
                     href={menu.path}
                     class="flex items-center gap-1 hover:text-rose-300 transition"
                  >
                     {menu.name}
                     {menu.childerns.length > 0 && (
                        <svg
                           xmlns="http://www.w3.org/2000/svg"
                           class="h-4 w-4 transition-transform group-hover:rotate-180"
                           fill="none"
                           viewBox="0 0 24 24"
                           stroke="currentColor"
                        >
                           <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M19 9l-7 7-7-7"
                           />
                        </svg>
                     )}
                  </a>

                  {menu.childerns.length > 0 && (
                     <ul class="absolute left-0 top-full hidden group-hover:block bg-white shadow-lg mt-1 rounded-md min-w-[180px] z-20 text-gray-700 before:absolute before:-top-2 before:left-0 before:w-full before:h-3">
                        {menu.childerns.map((child) => (
                           <li class="relative group/drop">
                              <a
                                 href={child.path}
                                 class="flex items-center text-stone-900 rounded-lg justify-between px-5 py-3 hover:bg-rose-50 hover:text-rose-700"
                              >
                                 {child.name}
                                 {child.childerns.length > 0 && (
                                    <svg
                                       xmlns="http://www.w3.org/2000/svg"
                                       class="h-4 w-4"
                                       fill="none"
                                       viewBox="0 0 24 24"
                                       stroke="currentColor"
                                    >
                                       <path
                                          stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M9 5l7 7-7 7"
                                       />
                                    </svg>
                                 )}
                              </a>

                              {child.childerns.length > 0 && (
                                 <ul class="absolute top-0 left-full hidden group-hover/drop:block bg-white shadow-lg rounded-md min-w-[180px] text-gray-700 before:absolute before:-left-3 before:top-0 before:w-3 before:h-full">
                                    {child.childerns.map((sub) => (
                                       <li>
                                          <a
                                             href={sub.path}
                                             class="block text-stone-900 rounded-lg px-5 py-3 hover:bg-rose-50 hover:text-rose-700"
                                          >
                                             {sub.name}
                                          </a>
                                       </li>
                                    ))}
                                 </ul>
                              )}
                           </li>
                        ))}
                     </ul>
                  )}
               </li>
            ))
         }
      </ul>
   </nav>

   <!-- MOBILE MENU -->
   <div
      id="mobile-menu"
      class="fixed inset-0 bg-white h-screen text-gray-800 hidden flex-col items-start p-6 pt-20 z-40 md:hidden transition-all duration-300 max-h-screen opacity-0 translate-y-[-10px]"
   >
      {
         menus.map((menu) => (
            <div class="w-full mb-4">
               <details class="group overflow-visible">
                  <summary class="cursor-pointer flex justify-between items-center py-2 text-lg font-medium hover:text-rose-600">
                     {menu.name}
                     {menu.childerns.length > 0 && (
                        <svg
                           xmlns="http://www.w3.org/2000/svg"
                           class="h-4 w-4 transition-transform group-open:rotate-180"
                           fill="none"
                           viewBox="0 0 24 24"
                           stroke="currentColor"
                        >
                           <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M19 9l-7 7-7-7"
                           />
                        </svg>
                     )}
                  </summary>
                  {menu.childerns.length > 0 && (
                     <div class="pl-4 border-l border-gray-200">
                        {menu.childerns.map((child) => (
                           <details class="group overflow-visible">
                              <summary class="cursor-pointer flex justify-between items-center py-2 hover:text-rose-600">
                                 {child.name}
                                 {child.childerns.length > 0 && (
                                    <svg
                                       xmlns="http://www.w3.org/2000/svg"
                                       class="h-4 w-4 transition-transform group-open:rotate-180"
                                       fill="none"
                                       viewBox="0 0 24 24"
                                       stroke="currentColor"
                                    >
                                       <path
                                          stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M9 5l7 7-7 7"
                                       />
                                    </svg>
                                 )}
                              </summary>
                              {child.childerns.length > 0 && (
                                 <ul class="pl-4 border-l border-gray-200">
                                    {child.childerns.map((sub) => (
                                       <li class="py-1 hover:text-rose-600">
                                          <a href={sub.path}>{sub.name}</a>
                                       </li>
                                    ))}
                                 </ul>
                              )}
                           </details>
                        ))}
                     </div>
                  )}
               </details>
            </div>
         ))
      }
   </div>
</header>

<!-- SCRIPT -->
<script>
   document.addEventListener("DOMContentLoaded", () => {
      const navbar = document.getElementById("navbar");
      const toggle = document.getElementById("menu-toggle");
      const mobileMenu = document.getElementById("mobile-menu");
      const heroHeight = navbar ? navbar.offsetHeight + 50 : 100;
      let isMenuOpen = false;
      const masterMenus =
         document.querySelectorAll<HTMLAnchorElement>("ul#menu > li > a");

      const setNavbarScrolled = (scrolled: any) => {
         if (scrolled) {
            navbar?.classList.add("bg-white", "backdrop-blur-md");
            mobileMenu?.classList.add("bg-white", "backdrop-blur-md");
            navbar?.classList.remove("bg-transparent");
            masterMenus.forEach((a) => {
               a.classList.remove("text-white");
               a.classList.add("text-gray-800");
            });
            document.querySelectorAll("#menu-toggle span").forEach((s) => {
               s.classList.remove("bg-white");
               s.classList.add("bg-gray-800");
            });
         } else {
            navbar?.classList.remove("bg-white", "backdrop-blur-md");
            mobileMenu?.classList.remove("bg-white", "backdrop-blur-md");
            navbar?.classList.add("bg-transparent");
            masterMenus.forEach((a) => {
               a.classList.add("text-white");
               a.classList.remove("text-gray-800");
            });
            document.querySelectorAll("#menu-toggle span").forEach((s) => {
               s.classList.add("bg-white");
               s.classList.remove("bg-gray-800");
            });
         }
      };

      const handleScroll = () => {
         if (!isMenuOpen) {
            const scrolled = window.scrollY > heroHeight;
            setNavbarScrolled(scrolled);
         }
      };

      // Initial setup
      handleScroll();
      window.addEventListener("scroll", handleScroll);

      // Hamburger toggle open/close
      toggle?.addEventListener("click", () => {
         isMenuOpen = !isMenuOpen;
         toggle.setAttribute("data-open", String(isMenuOpen));

         const [l1, l2, l3] = toggle.querySelectorAll("span");

         if (isMenuOpen) {
            // Force black navbar
            navbar && navbar.classList.add("bg-white/50", "backdrop-blur-sm");
            navbar && navbar.classList.remove("bg-transparent");
            navbar &&
               navbar.querySelectorAll("a").forEach((a) => {
                  a.classList.remove("text-white");
                  a.classList.add("text-gray-800");
               });
            document.querySelectorAll("#menu-toggle span").forEach((s) => {
               s.classList.remove("bg-white");
               s.classList.add("bg-gray-800");
            });

            // Animate hamburger
            l1.classList.add("rotate-45", "translate-y-[9px]", "w-8");
            l2.classList.add("opacity-0");
            l3.classList.add("-rotate-45", "-translate-y-[9px]", "w-8");

            mobileMenu?.classList.remove("hidden");
            setTimeout(() => {
               mobileMenu?.classList.add("opacity-100", "translate-y-0");
               mobileMenu?.classList.remove("opacity-0", "translate-y-[-10px]");
            }, 10);
         } else {
            // Close menu → return to scroll logic
            l1.classList.remove("rotate-45", "translate-y-[9px]", "w-8");
            l2.classList.remove("opacity-0");
            l3.classList.remove("-rotate-45", "-translate-y-[9px]");

            mobileMenu?.classList.add("opacity-0", "translate-y-[-10px]");
            mobileMenu?.classList.remove("opacity-100", "translate-y-0");
            setTimeout(() => mobileMenu?.classList.add("hidden"), 300);

            handleScroll(); // immediately update navbar color based on scroll position
         }
      });

      // Smart submenu positioning
      document.querySelectorAll("ul > li.relative").forEach((item) => {
         const submenu = item.querySelector("ul.absolute");
         if (submenu) {
            item.addEventListener("mouseenter", () => {
               const rect = submenu.getBoundingClientRect();
               if (rect.right > window.innerWidth) {
                  submenu.classList.add("right-full");
                  submenu.classList.remove("left-full");
               }
            });
         }
      });
   });
</script>
