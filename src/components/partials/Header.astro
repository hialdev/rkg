---
import { Image } from "astro:assets";
import logoRkg from "../../assets/rkgtour.webp";
import LocaleMenu from "./LocaleMenu";
import LocaleMobileMenu from "./LocaleMobileMenu";
import { getSetting } from "../../fetchers";

const { isFloating = false } = Astro.props;
const logo = await getSetting("dash.logo");
const logoImage = logo ? import.meta.env.PUBLIC_API_URL+'/'+logo.data.data.set_value : logoRkg;
---

<header
   id="navbar"
   class={`${
      isFloating
         ? "fixed top-0 left-0 w-full z-50 bg-transparent transition-all duration-300"
         : "relative w-full bg-white text-stone-900"
   }`}
>
   <nav class="container mx-auto flex items-center justify-between py-3 px-4">
      <!-- LOGO -->
      <div class="flex items-center gap-2">
         <a href="/">
            <Image src={logoImage} alt="logo RKG" width={60} height={60} class={`w-full max-h-[60px] object-contain`} />
         </a>
      </div>

      <!-- HAMBURGER ICON -->
      <button
         id="menu-toggle"
         data-open="false"
         class={`flex flex-col gap-[6px] md:hidden fixed top-6 right-4 z-[70] w-8 h-8 justify-center items-end transition-all ${
            isFloating ? "md:text-white" : "text-gray-800"
         }`}
      >
         <span
            class={`line-1 block w-6 h-[3px] ${
               isFloating ? "md:bg-white" : "bg-gray-800"
            } rounded-full transition-all`}></span>
         <span
            class={`line-2 block w-4 h-[3px] ${
               isFloating ? "md:bg-white" : "bg-gray-800"
            } rounded-full self-end transition-all`}></span>
         <span
            class={`line-3 block w-8 h-[3px] ${
               isFloating ? "md:bg-white" : "bg-gray-800"
            } rounded-full transition-all`}></span>
      </button>

      <LocaleMenu client:only="react" {isFloating} />
   </nav>

   <div
      id="mobile-menu"
      class={`fixed inset-0 h-screen bg-white hidden flex-col items-start p-6 pt-20 z-40 md:hidden transition-all duration-300 max-h-screen opacity-0 translate-y-[-10px] text-gray-800`}
   >
      <LocaleMobileMenu
         client:only="react"
         onClose={() => {
            const mobileMenu = document.getElementById("mobile-menu");
            const toggle = document.getElementById("menu-toggle");
            if (mobileMenu && toggle) {
               mobileMenu.classList.add("opacity-0", "translate-y-[-10px]");
               setTimeout(() => mobileMenu.classList.add("hidden"), 300);
               toggle.setAttribute("data-open", "false");
               const [l1, l2, l3] = toggle.querySelectorAll("span");
               l1?.classList.remove("rotate-45", "translate-y-[9px]", "w-8");
               l2?.classList.remove("opacity-0");
               l3?.classList.remove("-rotate-45", "-translate-y-[9px]");
            }
         }}
      />
   </div>
</header>

<script>
   document.addEventListener("DOMContentLoaded", () => {
      const navbar = document.getElementById("navbar");
      const toggle = document.getElementById("menu-toggle");
      const mobileMenu = document.getElementById("mobile-menu");
      const heroHeight = navbar ? navbar.offsetHeight + 50 : 100;
      let isMenuOpen = false;
      const masterMenus =
         document.querySelectorAll<HTMLAnchorElement>("ul#menu > li > a");

      const setNavbarScrolled = (scrolled: any) => {
         if (scrolled) {
            navbar?.classList.add("bg-white", "backdrop-blur-md");
            mobileMenu?.classList.add("bg-white", "backdrop-blur-md");
            navbar?.classList.remove("bg-transparent");
            masterMenus.forEach((a) => {
               a.classList.remove("text-white");
               a.classList.add("text-gray-800");
            });
            document.querySelectorAll("#menu-toggle span").forEach((s) => {
               s.classList.remove("bg-white");
               s.classList.add("bg-gray-800");
            });
         } else {
            navbar?.classList.remove("bg-white", "backdrop-blur-md");
            mobileMenu?.classList.remove("backdrop-blur-md");
            navbar?.classList.add("bg-transparent");
            masterMenus.forEach((a) => {
               a.classList.add("text-white");
               a.classList.remove("text-gray-800");
            });
         }
      };

      const handleScroll = () => {
         if (!isMenuOpen) {
            const scrolled = window.scrollY > heroHeight;
            setNavbarScrolled(scrolled);
         }
      };

      // Initial setup
      handleScroll();
      window.addEventListener("scroll", handleScroll);

      // Hamburger toggle open/close
      toggle?.addEventListener("click", () => {
         isMenuOpen = !isMenuOpen;
         toggle.setAttribute("data-open", String(isMenuOpen));

         const [l1, l2, l3] = toggle.querySelectorAll("span");

         if (isMenuOpen) {
            // Force black navbar
            navbar && navbar.classList.add("bg-white");
            navbar && navbar.classList.remove("bg-transparent");
            navbar &&
               navbar.querySelectorAll("a").forEach((a) => {
                  a.classList.remove("text-white");
                  a.classList.add("text-gray-800");
               });
            document.querySelectorAll("#menu-toggle span").forEach((s) => {
               s.classList.remove("bg-white");
               s.classList.add("bg-gray-800");
            });

            // Animate hamburger
            l1.classList.add("rotate-45", "translate-y-[9px]", "w-8");
            l2.classList.add("opacity-0");
            l3.classList.add("-rotate-45", "-translate-y-[9px]", "w-8");

            mobileMenu?.classList.remove("hidden");
            setTimeout(() => {
               mobileMenu?.classList.add("opacity-100", "translate-y-0");
               mobileMenu?.classList.remove("opacity-0", "translate-y-[-10px]");
            }, 10);
         } else {
            // Close menu → return to scroll logic
            l1.classList.remove("rotate-45", "translate-y-[9px]", "w-8");
            l2.classList.remove("opacity-0");
            l3.classList.remove("-rotate-45", "-translate-y-[9px]");

            mobileMenu?.classList.add("opacity-0", "translate-y-[-10px]");
            mobileMenu?.classList.remove("opacity-100", "translate-y-0");
            setTimeout(() => mobileMenu?.classList.add("hidden"), 300);

            handleScroll(); // immediately update navbar color based on scroll position
         }
      });

      // Smart submenu positioning
      document.querySelectorAll("ul > li.relative").forEach((item) => {
         const submenu = item.querySelector("ul.absolute");
         if (submenu) {
            item.addEventListener("mouseenter", () => {
               const rect = submenu.getBoundingClientRect();
               if (rect.right > window.innerWidth) {
                  submenu.classList.add("right-full");
                  submenu.classList.remove("left-full");
               }
            });
         }
      });
   });
</script>
